diff --git a/lib/providers/antigravity-cli.js b/lib/providers/antigravity-cli.js
new file mode 100644
--- /dev/null
+++ b/lib/providers/antigravity-cli.js
@@ -0,0 +1,73 @@
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+
+const PINNED_VERSION = '1.5.18';
+// Changelist captured from the agy 1.5.18 request headers.
+const PINNED_CL = '1030252320';
+const OS = { linux: 'linux', darwin: 'darwin', win32: 'windows' };
+const ARCH = { x64: 'amd64', arm64: 'arm64' };
+let cachedUserAgent;
+
+async function agyVersion() {
+    const run = promisify(execFile);
+    const options = {
+        timeout: 2000,
+        killSignal: 'SIGKILL',
+        encoding: 'utf8',
+        windowsHide: true,
+    };
+    let stdout;
+    try {
+        ({ stdout } = await run('agy', ['--version'], options));
+    }
+    catch (error) {
+        // A missing, failing or slow agy on PATH uses the pinned CLI version.
+        return undefined;
+    }
+    return /(?:^|[\s(])v?(\d+\.\d+\.\d+)(?=$|[\s)])/u.exec(stdout)?.[1];
+}
+
+/** Default User-Agent for Antigravity v1internal requests, detected once on first use. */
+export function antigravityCliUserAgent() {
+    cachedUserAgent ??= agyVersion().then(detected => {
+        const version = detected ?? PINNED_VERSION;
+        const os = OS[process.platform] ?? process.platform;
+        const arch = ARCH[process.arch] ?? process.arch;
+        return `antigravity/cli/${version} (aidev_client; os_type=${os}; arch=${arch}; cl=${PINNED_CL}; auth_method=consumer)`;
+    });
+    return cachedUserAgent;
+}
+
+/** Model IDs with a fixed thinking effort carry that effort as a final suffix. */
+export function antigravityFixedEffort(model) {
+    return /-(low|medium|high|xhigh)$/.exec(model)?.[1];
+}
+
+function isMediaOnly(modalities) {
+    return Array.isArray(modalities) && !modalities.includes('text')
+        && modalities.some(modality => modality === 'image' || modality === 'audio');
+}
+
+/** Resolve the server's agent model order, or filter catalogs from older servers. */
+export function antigravityCatalogEntries(payload) {
+    const { models, agentModelSorts } = payload;
+    if (Array.isArray(agentModelSorts)) {
+        const ids = new Set();
+        for (const sort of agentModelSorts) {
+            for (const group of Array.isArray(sort?.groups) ? sort.groups : []) {
+                for (const id of Array.isArray(group?.modelIds) ? group.modelIds : []) {
+                    if (typeof id === 'string' && Object.hasOwn(models, id) && models[id] != null)
+                        ids.add(id);
+                }
+            }
+        }
+        return [...ids].map(id => [id, models[id]]);
+    }
+    const mediaIds = new Set([
+        ...(Array.isArray(payload.imageGenerationModelIds) ? payload.imageGenerationModelIds : []),
+        ...(Array.isArray(payload.audioTranscriptionModelIds) ? payload.audioTranscriptionModelIds : []),
+    ]);
+    return Object.entries(models).filter(([id, model]) => model != null
+        && !/^(tab|chat)_/.test(id) && !model.isInternal && !mediaIds.has(id)
+        && !isMediaOnly(model.inputModalities) && !isMediaOnly(model.outputModalities));
+}
