# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# Windows command scripts require CRLF in the working tree for cmd.exe; the
# override after the default keeps the in-repo form normalized as text.
* text=auto eol=lf
*.cmd text eol=crlf

*.pdf binary

# The persistence catalog is the readable projection of these generated schemas.
docs/persistence-schema.json linguist-generated=true
docs/persistence-changes/*.schema.json linguist-generated=true
docs/persistence-changes/releases/*.schema.json linguist-generated=true
docs/persistence-changes/historical-formats/*.schema.json linguist-generated=true

# Upstream-owned (from deepseek-harness fork) — hide từ GitHub language stats
# và folder highlights. Files vẫn checkout bình thường, chỉ giảm noise trên
# repo landing page.
vendor/**            linguist-vendored
docs/**              linguist-documentation
website/**           linguist-vendored
examples/**          linguist-documentation
python/**            linguist-vendored
native/**            linguist-vendored
patches/**           linguist-vendored
.agents/**           linguist-documentation
BRAND_GUIDELINES*    linguist-documentation
CONTRIBUTING*        linguist-documentation
*.i18n.yaml          linguist-generated
scripts/snapshots/** linguist-generated
scripts/fixtures/**  linguist-generated
# Context lines of a patch over tab-indented dist code start with " \t".
patches/dsh-plugin-subscriptions.patch -whitespace
