{
  "name": "@ahvclaw/dsh-bundle-ahv",
  "description": "AHV Holding profile bundle: rewires dsh-base to the AHV router (auto.ahvchat.com) with a Vietnamese-first persona. Loaded by `dsh --profile ahv` or the `ahv` bin default profile.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bot-runner": {
      "types": "./lib/types/bot-runner.d.ts",
      "default": "./lib/bot-runner.js"
    },
    "./bot-startup": {
      "types": "./lib/types/bot-startup.d.ts",
      "default": "./lib/bot-startup.js"
    },
    "./bot-list-models": {
      "types": "./lib/types/bot-list-models.d.ts",
      "default": "./lib/bot-list-models.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.patch.web.yml": "./cordis.patch.web.yml",
    "./cordis.patch.bot.yml": "./cordis.patch.bot.yml",
    "./cordis.patch.list-models.yml": "./cordis.patch.list-models.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bot-runner.js",
    "lib/bot-startup.js",
    "lib/bot-list-models.js",
    "cordis.patch.yml",
    "cordis.patch.web.yml",
    "cordis.patch.bot.yml",
    "cordis.patch.list-models.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-terminal-bash": "workspace:^",
    "@deepseek-ai/dsh-tool-terminal": "workspace:^",
    "@deepseek-ai/dsh-cordis-host-runner": "workspace:^",
    "@deepseek-ai/dsh-tool-cordis": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-headless": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "commander": "^15.0.0",
    "dshmarket": "^1.38.1",
    "superpowers-dsh": "^0.1.1",
    "@linxin666/dsh-web-ui-all": "^0.2.7",
    "dsh-plugin-subscriptions": "^0.5.3",
    "@anweat/dsh-browser": "^0.1.10",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-session-stats": "workspace:^",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:^",
    "@deepseek-ai/dsh-session-list-metadata": "workspace:^"
  }
}
